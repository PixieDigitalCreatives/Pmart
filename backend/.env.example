# PMart backend environment — copy to backend/.env and fill in.
# Full reference: docs/PMart_ENVIRONMENT_REFERENCE.md. Never commit the real .env.

# ── Required ────────────────────────────────────────────────────────────────
# MongoDB replica set (MongoDB Atlas works; transactions need a replica set)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Signs access tokens. Production: 32+ random characters, no words like "secret"/"test".
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<long-random-string>
# Encrypts delivery codes: exactly 64 hex characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_ENCRYPTION_KEY=<64-hex-characters>

# ── Server ──────────────────────────────────────────────────────────────────
PORT=5003
NODE_ENV=development
MONGODB_DB_NAME=pmart
# Browser origins allowed (comma-separated). REQUIRED in production: exact https origins only, no * wildcards
# (the API refuses to start otherwise). In development any localhost port is allowed.
# ALLOWED_ORIGINS=https://thepmart.in,https://www.thepmart.in
# Sign-in cookie SameSite policy. Default: strict (production logs a warning for none).
#   strict — web app reaches the API through a same-site proxy (Vercel rewrite → Render)  ← recommended
#   none   — browser calls the API on another site directly (breaks where third-party cookies are blocked)
# COOKIE_SAME_SITE=strict
# Reverse proxies in front of the API (Render = 1, Vercel rewrite → Render = 2). Sets the client IP for rate limits.
# TRUST_PROXY=1

# ── Optional ────────────────────────────────────────────────────────────────
# JWT_EXPIRES_IN=1h
# REFRESH_TOKEN_TTL_DAYS=7
# Delivery code length: 4 or 6
# OTP_LENGTH=4
# Server-side reverse geocoding (address lookup)
# MAPTILER_API_KEY=
# Google sign-in (all three needed; otherwise Google sign-in is disabled)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# OSRM_CACHE_TTL=3600
# LOG_LEVEL=info
# RATE_LIMIT_IN_DEV=false
# MARG_INTEGRATION_ENABLED=false
# Barcode lookups in Open Food / Beauty / Products Facts (unknown-barcode details and candidate photos; never auto-verified)
# PRODUCT_LOOKUP_ENABLED=true
# Those services ask for an identifying User-Agent with a real contact e-mail
# PRODUCT_LOOKUP_USER_AGENT=PMart-Inventory/1.0 (store inventory; contact: you@example.com)

# Location V2 & Geoapify (optional; defaults to false)
# LOCATION_V2_ENABLED=false
# GEOAPIFY_API_KEY=
