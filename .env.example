# PMart web app environment (Vite). Local: copy to .env. Vercel: Project → Settings → Environment Variables.
# VITE_* values are built into the public JavaScript — never put secrets here.
# Full reference: docs/PMart_ENVIRONMENT_REFERENCE.md and docs/PMart_DEPLOYMENT.md

# ── API ──────────────────────────────────────────────────────────────────────
# Leave VITE_API_BASE_URL unset on Vercel: the app calls /api on its own domain and vercel.json forwards it to
# Render, which keeps the sign-in cookie first-party (Safari/Chrome block cross-site cookies).
# Only set it if you serve the API from the same site under another path, e.g. https://api.yourdomain.com/api.
# VITE_API_BASE_URL=

# Live updates (Socket.IO) connect straight to Render because Vercel can't forward WebSockets.
# Local development: leave unset (the Vite dev server proxies /socket.io).
VITE_SOCKET_URL=https://api.thepmart.in

# ── Maps (MapTiler) ──────────────────────────────────────────────────────────
# Required for maps, address search and tracking. Use a NEW key restricted to your Vercel domain.
VITE_MAPTILER_API_KEY=

# ── Google sign-in (optional; the backend also needs FIREBASE_*) ─────────────
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# ── Location V2 & Geoapify (optional; defaults to off) ───────────────────────
# VITE_LOCATION_V2_ENABLED=false
# VITE_GEOAPIFY_API_KEY=
