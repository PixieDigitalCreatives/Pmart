# PMart Frontend Environment Template (Vite)
# Copy to .env for local development, or configure in Netlify Environment Variables.
# Full reference: docs/PMart_ENVIRONMENT_REFERENCE.md

# ── API and Real-Time URLs (Point to your Render backend) ────────────────────
# In production on Netlify, point to your deployed Render service URL:
VITE_API_BASE_URL=https://pmart-backend.onrender.com/api
VITE_SOCKET_URL=https://pmart-backend.onrender.com

# ── Map & Geocoding (MapTiler) ───────────────────────────────────────────────
# Required for maps, darkstore radius checks, and delivery tracking:
VITE_MAPTILER_API_KEY=

# ── Google Sign-in (Firebase Web App - Optional) ─────────────────────────────
# Required only if Google authentication is enabled:
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
